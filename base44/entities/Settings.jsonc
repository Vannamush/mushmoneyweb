{
  "name": "Settings",
  "type": "object",
  "properties": {
    "budget": {
      "type": "number",
      "title": "Monthly budget",
      "default": 6000
    },
    "theme": {
      "type": "string",
      "enum": [
        "minimal",
        "dark",
        "playful"
      ],
      "title": "Theme",
      "default": "minimal"
    },
    "subscription_status": {
      "type": "string",
      "enum": [
        "none",
        "active",
        "cancelled"
      ],
      "title": "Subscription status",
      "default": "none"
    }
  }
}